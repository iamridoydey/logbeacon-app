<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'LogBeacon' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-bg text-text font-sans min-h-screen flex flex-col antialiased">

  <nav class="sticky top-0 z-50 bg-surface border-b border-border px-6 py-4 flex items-center justify-between">
    <a href="/" class="text-lg font-semibold text-text">
      Log<span class="text-accent">Beacon</span>
    </a>
    <div class="flex items-center gap-6 text-sm">
  <a href="/dashboard" class="text-muted hover:text-text transition-colors">Dashboard</a>
  <a href="/analyze" class="text-muted hover:text-text transition-colors">Analyze</a>
  <% if (isSignedIn) { %>
    <form method="POST" action="/auth/signout" class="inline">
      <button type="submit" class="text-bg bg-accent hover:bg-accent-hover px-4 py-1.5 rounded-md font-medium transition-colors">
        Sign Out
      </button>
    </form>
  <% } else { %>
    <a href="/auth/signin" class="text-bg bg-accent hover:bg-accent-hover px-4 py-1.5 rounded-md font-medium transition-colors">Sign In</a>
  <% } %>
</div>
  </nav>

  <main class="flex-1 px-6 py-6 pb-2">
    <%- body %>
  </main>

</body>
</html>