<div class="max-w-sm mx-auto bg-surface border border-border rounded-lg p-8">
  <h1 class="text-xl font-semibold text-text mb-6">Sign in</h1>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="bg-danger/10 border border-danger/30 text-danger text-sm px-4 py-3 rounded-md mb-4">
      <%= error %>
    </div>
  <% } %>

  <form method="POST" action="/auth/signin" class="space-y-4">
    <div>
      <label class="block text-sm text-muted mb-1">Username</label>
      <input type="text" name="username" required
             class="w-full bg-bg border border-border rounded-md px-3 py-2 text-sm text-text focus:outline-none focus:ring-2 focus:ring-accent">
    </div>
    <div>
      <label class="block text-sm text-muted mb-1">Password</label>
      <input type="password" name="password" required
             class="w-full bg-bg border border-border rounded-md px-3 py-2 text-sm text-text focus:outline-none focus:ring-2 focus:ring-accent">
    </div>
    <button type="submit"
            class="w-full bg-accent hover:bg-accent-hover text-bg font-medium py-2 rounded-md transition-colors">
      Sign In
    </button>
  </form>
  <p class="text-sm text-muted mt-4">
    Don't have an account? <a href="/auth/register" class="text-accent hover:text-accent-hover">Register</a>
  </p>
</div>