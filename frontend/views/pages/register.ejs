<div class="max-w-sm mx-auto bg-surface border border-border rounded-lg p-8">
  <h1 class="text-xl font-semibold text-text mb-6">Create an account</h1>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="bg-danger/10 border border-danger/30 text-danger text-sm px-4 py-3 rounded-md mb-4">
      <%= error %>
    </div>
  <% } %>

  <% if (typeof apiKey !== 'undefined' && apiKey) { %>
    <div class="bg-teal/10 border border-teal/30 text-teal text-sm px-4 py-3 rounded-md mb-4">
      <p class="font-medium">Account created. Save your API key — it won't be shown again:</p>
      <code class="block mt-2 bg-bg px-3 py-2 rounded border border-border text-xs font-mono text-text break-all">
        <%= apiKey %>
      </code>
      <a href="/auth/signin" class="inline-block mt-3 text-accent hover:text-accent-hover text-sm">Continue to sign in →</a>
    </div>
  <% } else { %>
    <form method="POST" action="/auth/register" class="space-y-4">
      <div>
        <label class="block text-sm text-muted mb-1">Username</label>
        <input type="text" name="username" required
               class="w-full bg-bg border border-border rounded-md px-3 py-2 text-sm text-text focus:outline-none focus:ring-2 focus:ring-accent">
      </div>
      <div>
        <label class="block text-sm text-muted mb-1">Email</label>
        <input type="email" name="email" required
               class="w-full bg-bg border border-border rounded-md px-3 py-2 text-sm text-text focus:outline-none focus:ring-2 focus:ring-accent">
      </div>
      <div>
        <label class="block text-sm text-muted mb-1">Password</label>
        <input type="password" name="password" required
               class="w-full bg-bg border border-border rounded-md px-3 py-2 text-sm text-text focus:outline-none focus:ring-2 focus:ring-accent">
      </div>
      <button type="submit"
              class="w-full bg-accent hover:bg-accent-hover text-bg font-medium py-2 rounded-md transition-colors">
        Register
      </button>
    </form>
    <p class="text-sm text-muted mt-4">
      Already have an account? <a href="/auth/signin" class="text-accent hover:text-accent-hover">Sign in</a>
    </p>
  <% } %>
</div>